<aside class="sidebar flex flex-col justify-start">
    <div class="lg:sticky lg:top-32">

        {{#is "post"}}
            {{#get "posts" limit="3" filter="tag:-[hash-portfolio,hash-kusi-doc,hash-podcast,hash-note]+id:-{{id}}" as |sidebar_latest_post| }}
                {{> "sidebar/sidebar-post-card" widgetTitle=(t "Latest Posts") widgetPosts=sidebar_latest_post }}
            {{/get}}

            {{!-- Latest notes shown separately from articles --}}
            {{#get "posts" limit="3" filter="tag:[hash-note]+id:-{{id}}" as |sidebar_notes| }}
                {{#if sidebar_notes}}
                    {{> "sidebar/sidebar-post-card" widgetTitle=(t "Latest Notes") widgetPosts=sidebar_notes noteCards=true }}
                {{/if}}
            {{/get}}
        {{else}}
            {{#get "posts" filter="featured:true" limit="3" as |sidebar_featured_post| }}
                {{#if sidebar_featured_post}}
                    {{> "sidebar/sidebar-post-card" widgetTitle=(t "Featured Articles") widgetPosts=sidebar_featured_post }}
                {{/if}}
            {{/get}}
        {{/is}}

    </div>
</aside>
