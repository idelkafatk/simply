{{!--
  A post in a list: 84px cover (72px on a phone), title, date on desktop.
  Pass eager=true for rows on the first screen: they load at once with high
  priority, the rest lazily. Hand-drawn covers (-light/-dark pairs) have a flat
  background that the "art" class blends into the row, so hover shows no box.
--}}
<a class="row" href="{{url}}">
    {{~#if feature_image}}
    <img class="thumb{{#match feature_image "~" "-light."}} art{{/match}}{{#match feature_image "~" "-dark."}} art{{/match}}"
        src="{{img_url feature_image size="s"}}"
        srcset="{{img_url feature_image size="xs"}} 100w, {{img_url feature_image size="s"}} 300w"
        sizes="(max-width: 640px) 72px, 84px"
        width="84" height="56" alt=""
        {{#if eager}}fetchpriority="high"{{else}}loading="lazy"{{/if}} decoding="async">
    {{~else}}
    <span class="thumb is-empty">{{> "site/icon" name="note"}}</span>
    {{~/if}}
    <span class="t">{{title}}</span>
    <time class="d" datetime="{{date format="YYYY-MM-DD"}}">{{date format="D"}} {{> "site/month-short"}}</time>
</a>
