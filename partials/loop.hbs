<div class="site-post py-vmin8 px-4">
    {{#if notesAuthor}}
        {{#get "posts" filter="tag:hash-note+authors:{{notesAuthor}}" limit="10" as |notes|}}
            {{#if notes}}
                <div class="mx-auto max-w-extreme">
                    {{> "components/notes-carousel" carouselId="author-notes" widgetTitle=(t "Latest Notes") widgetPosts=notes}}
                </div>
            {{/if}}
        {{/get}}
    {{/if}}

    <div class="js-feed-entry mx-auto max-w-1100 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{#if hideNotes}}
            {{#foreach posts}}
                {{#has tag="#note, hash-note"}}
                    {{!-- Notes are surfaced in the author carousel --}}
                {{else}}
                    {{> "story/story-grid"}}
                {{/has}}
            {{/foreach}}
        {{else}}
            {{#foreach posts}}
                {{> "story/story-grid"}}
            {{/foreach}}
        {{/if}}
    </div>

    {{!-- Pagination - partials/pagination.hbs --}}
    {{pagination}}
</div>
