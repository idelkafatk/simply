{{#if @member}}
{{!-- Button Updgrade --}}
{{!-- {{#unless @member.paid}}<a class="button mr-2 text-sm font-medium hidden md:flex" href="{{@site.url}}/membership/">{{t "Upgrade"}}</a>{{/unless}} --}}
{{#unless @member.paid}}<a data-portal="account/plans" class="button is-black mr-2 text-sm font-medium hidden lg:flex" href="#">{{t "Upgrade"}}</a>{{/unless}}

{{!-- The avatar opens the account panel of the card (partials/mobile-navigation.hbs),
      the same one the phone menu leads to. --}}
{{!-- https://ghost.org/docs/members/member-data/ --}}
<a href="#/portal/account" data-portal="account" aria-label="{{t "Account"}}" title="{{t "Account"}}" class="relative w-8 h-8 hidden overflow-hidden rounded-full lg:inline-block lg:ml-3">
    <span class="absolute inset-0 text-gray-400">{{> "icons/avatar"}}</span>
    {{#if @member.avatar_image}}<img class="inset-image" alt="" width="32" height="32" src="{{@member.avatar_image}}"/>{{/if}}
</a>

{{else}}

{{!-- <a class="button is-white mr-2 text-sm font-medium hidden md:flex" href="{{@site.url}}/signin/">{{t "Log in"}}</a> --}}
<a data-portal="signin" class="button is-white mr-2 text-sm font-medium hidden lg:flex" href="#/portal/signin">{{t "Log in"}}</a>
{{!-- <a class="button is-primary text-sm font-medium hidden md:flex" href="{{@site.url}}/membership/">{{t "Subscribe"}}</a> --}}
<a data-portal="signup" class="button is-primary text-sm font-medium hidden lg:flex" href="#/portal/signup">{{t "Subscribe"}}</a>

{{/if}}
