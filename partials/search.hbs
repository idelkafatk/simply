{{!--
    Custom search UI, replacing Ghost's sodo-search (excluded in default.hbs via
    {{ghost_head exclude="search"}}). A bottom sheet on phones, a centred dialog
    on desktop; results reuse the list rows. Behaviour: src/js/search.js.
    The Content API key is public and read-only.
--}}
<div
    class="search"
    data-search
    data-search-key="{{content_api_key}}"
    data-search-empty="Ничего не найдено"
    data-search-loading="Загрузка…"
    data-search-error="Поиск временно недоступен"
    hidden
>
    <button class="search-backdrop" type="button" tabindex="-1" aria-label="Закрыть поиск" aria-hidden="true" data-search-close></button>

    <div class="search-sheet" id="search-sheet" role="dialog" aria-modal="true" aria-label="Поиск" data-search-sheet tabindex="-1">
        <div class="search-field">
            {{> "site/icon" name="search" class="search-field-icon"}}
            <input
                class="search-input"
                type="search"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                enterkeyhint="search"
                placeholder="Поиск"
                aria-label="Поиск"
                aria-controls="search-results"
                data-search-input
            />
            <button class="search-clear" type="button" aria-label="Очистить" data-search-clear hidden>{{> "site/icon" name="close"}}</button>
            <button class="search-cancel" type="button" aria-label="Закрыть поиск" title="Закрыть поиск" data-search-close>{{> "site/icon" name="close"}}</button>
        </div>

        <div class="search-results" id="search-results" role="listbox" aria-label="Поиск" data-search-results></div>

        <p class="search-message" data-search-message hidden></p>
    </div>
</div>
