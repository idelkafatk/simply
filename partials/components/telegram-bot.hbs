{{!-- Telegram Bot Promo Block - Always visible --}}
<div class="telegram-promo pt-vmin8">
    <div class="telegram-promo-card border border-gray-300 rounded-lg p-6 md:p-8 bg-gray-100 relative overflow-hidden">
        {{!-- Telegram Icon Background --}}
        <div class="telegram-promo-bg absolute right-0 top-0 opacity-[0.07] pointer-events-none">
            <svg width="140" height="140" viewBox="0 0 24 24" fill="currentColor" class="text-title">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
        </div>

        <div class="relative z-1">
            {{!-- Header --}}
            <div class="flex items-start md:items-center flex-col md:flex-row gap-3 md:gap-4 mb-4">
                <div class="telegram-icon flex-none w-12 h-12 rounded-full bg-[#0088cc] flex items-center justify-center overflow-hidden">
                    {{#if @site.logo}}
                        <img src="{{@site.logo}}" alt="{{@site.title}}" class="w-full h-full object-cover" />
                    {{else}}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                        </svg>
                    {{/if}}
                </div>
                <div class="flex-1">
                    <h3 class="text-lg md:text-xl font-bold text-title mb-1">{{@site.title}} в Telegram</h3>
                    <p class="text-sm text-gray-500">Уведомления о новых постах и связь с автором</p>
                </div>
            </div>

            {{!-- Bot Link --}}
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                <a href="https://t.me/idel_blog_bot"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="telegram-bot-link inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-[#0088cc] hover:bg-[#0077b5] text-white font-medium transition-all duration-200 hover:shadow-lg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                    </svg>
                    <span>@idel_blog_bot</span>
                </a>

                {{!-- Subscribe button for non-members --}}
                {{#unless @member}}
                {{#if @site.members_enabled}}
                <a href="#/portal"
                   data-portal
                   class="subscribe-cta inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full border-2 border-primary bg-transparent hover:bg-primary text-primary hover:text-white font-medium transition-all duration-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                    </svg>
                    <span>Подписаться</span>
                </a>
                {{/if}}
                {{/unless}}
            </div>
        </div>
    </div>
</div>
