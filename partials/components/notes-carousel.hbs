{{!-- Horizontal notes carousel. Expects carouselId + widgetTitle + widgetPosts.
      Follows docs/mobile-design.md: the way to all notes is a quiet line by
      the heading, not a button, and a card is a soft fill with no outline.
      The title link covers the whole card, so the preview can be the note's
      own markup (it has links of its own, which cannot sit inside a link). --}}
<section class="notes-carousel js-notes-carousel" data-notes-carousel aria-labelledby="{{carouselId}}-title">
    <header class="notes-carousel-header">
        <h2 id="{{carouselId}}-title" class="text-2xl font-semibold text-title">{{widgetTitle}}</h2>
        <a href="/notes/" class="notes-carousel-all" aria-label="{{t "See all"}}">
            <span>{{t "All"}}</span>
            {{> "icons/chevron-right" class="notes-carousel-all-icon"}}
        </a>
    </header>

    <div class="notes-carousel-viewport">
        <div id="{{carouselId}}-track" class="notes-carousel-track" data-notes-carousel-track role="list" tabindex="0">
            {{#foreach widgetPosts}}
                <article class="notes-carousel-card {{#if feature_image}}has-image{{/if}}" data-notes-carousel-item role="listitem">
                    <div class="notes-carousel-content">
                        {{#if feature_image}}
                            <figure class="notes-carousel-media">
                                <img src="{{img_url feature_image size="s"}}"
                                    srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w"
                                    sizes="(min-width: 768px) 300px, 80vw"
                                    loading="lazy"
                                    decoding="async"
                                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
                            </figure>
                        {{/if}}

                        <div class="notes-carousel-body">
                            <time class="notes-carousel-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
                            <h3 class="notes-carousel-title text-title"><a href="{{url}}" class="notes-carousel-link">{{title}}</a></h3>
                            <div class="notes-carousel-excerpt text-global">{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{else}}{{content words="200"}}{{/if}}</div>
                        </div>
                    </div>
                </article>
            {{/foreach}}
        </div>

        <button class="notes-carousel-nav notes-carousel-nav-prev js-notes-carousel-prev" type="button" aria-label="{{t "Previous notes"}}" aria-controls="{{carouselId}}-track">
            <svg class="icon rotate-180 transform" aria-hidden="true"><use xlink:href="#icon-arrow-forward"></use></svg>
        </button>
        <button class="notes-carousel-nav notes-carousel-nav-next js-notes-carousel-next" type="button" aria-label="{{t "Next notes"}}" aria-controls="{{carouselId}}-track">
            <svg class="icon" aria-hidden="true"><use xlink:href="#icon-arrow-forward"></use></svg>
        </button>
    </div>

    <div class="notes-carousel-pagination" data-notes-carousel-pagination role="status" aria-live="polite"></div>

</section>
