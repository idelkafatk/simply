{{!-- Topics mirror the /notes/* channels declared in routes.yaml. Each topic is
      shown only when at least one note exists for it. --}}
<nav class="notes-topic-filter" aria-label="Notes by topic">
    <a class="notes-topic-filter-link {{#if allActive}}is-active{{/if}}" href="/notes/">{{t "All"}}</a>

    {{#get "posts" filter="tag:hash-note+tag:guides" limit="1"}}
        {{#if posts}}
            {{#link href="/notes/guides/" class="notes-topic-filter-link" activeClass="is-active"}}#Гайды{{/link}}
        {{/if}}
    {{/get}}
    {{#get "posts" filter="tag:hash-note+tag:korea" limit="1"}}
        {{#if posts}}
            {{#link href="/notes/korea/" class="notes-topic-filter-link" activeClass="is-active"}}#Корея{{/link}}
        {{/if}}
    {{/get}}
    {{#get "posts" filter="tag:hash-note+tag:life" limit="1"}}
        {{#if posts}}
            {{#link href="/notes/life/" class="notes-topic-filter-link" activeClass="is-active"}}#Повседневность{{/link}}
        {{/if}}
    {{/get}}
    {{#get "posts" filter="tag:hash-note+tag:travel" limit="1"}}
        {{#if posts}}
            {{#link href="/notes/travel/" class="notes-topic-filter-link" activeClass="is-active"}}#Путешествия{{/link}}
        {{/if}}
    {{/get}}
    {{#get "posts" filter="tag:hash-note+tag:relocation" limit="1"}}
        {{#if posts}}
            {{#link href="/notes/relocation/" class="notes-topic-filter-link" activeClass="is-active"}}#Релокация{{/link}}
        {{/if}}
    {{/get}}
    {{#get "posts" filter="tag:hash-note+tag:tech" limit="1"}}
        {{#if posts}}
            {{#link href="/notes/tech/" class="notes-topic-filter-link" activeClass="is-active"}}#Технологии{{/link}}
        {{/if}}
    {{/get}}
    {{#get "posts" filter="tag:hash-note+tag:japan" limit="1"}}
        {{#if posts}}
            {{#link href="/notes/japan/" class="notes-topic-filter-link" activeClass="is-active"}}#Япония{{/link}}
        {{/if}}
    {{/get}}
</nav>
