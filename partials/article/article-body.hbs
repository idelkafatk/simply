<section id="post-body" class="post-body godo-canvas mx-auto relative {{#match @custom.post_font "=" "font-serif"}}font-serif{{else}}font-sans{{/match}}">{{content}}</section>

{{#if access}}

<footer class="post-footer godo-canvas pt-10">
    {{!-- Tags + share on one row - ./partials/components/tags.hbs, ./partials/components/share-link.hbs --}}
    <div class="post-footer-actions flex items-start flex-wrap gap-4 mb-8">
        {{> "components/tags"}}
        {{> "components/share-link" label=true class="ml-auto" Tracking_name="Footer"}}
    </div>

    {{!-- Newsletter - ./partials/components/newsletter.hbs --}}
    {{> "components/newsletter"}}

    {{!-- Telegram - ./partials/components/telegram-card.hbs --}}
    {{> "components/telegram-card"}}

    {{!-- Previous and next article --}}
    {{#if @custom.show_prev_and_next_post}}
    <div class="prev-next pb-8">
        <hr class="my-10">
        {{> "article/article-previous-next"}}
    </div>
    {{/if}}
</footer>

{{/if}}
