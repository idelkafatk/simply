{{#if comments}}
<div class="post-comments py-8">
    <div class="mx-auto px-4 max-w-3xl">
        {{comments title=(t "Discussion")}}
        {{!--
          comments-ui подключается с defer и фиксирует конфиг при первом рендере.
          В режиме "auto" он угадывает схему по контрасту цвета текста родителя —
          ненадёжно и не реагирует на класс .dark у <html>. Проставляем схему явно
          здесь: инлайн-скрипт выполняется парсером раньше отложенного бандла.
          Дальнейшие переключения темы догоняет updateCommentsTheme() в main.js.
        --}}
        <script>
        (function () {
            var script = document.querySelector('script[data-ghost-comments]');
            if (!script) return;
            script.setAttribute(
                'data-color-scheme',
                document.documentElement.classList.contains('dark') ? 'dark' : 'light'
            );
        })();
        </script>
    </div>
</div>
{{/if}}
