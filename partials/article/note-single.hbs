{{!-- Single note, forum-thread / status style. Rendered inside {{#post}}. --}}
<article class="note-single mx-auto max-w-2xl py-vmin8 px-4">
    <div class="note-single-thread border-t border-gray-300 pt-8">
        <header class="note-single-header mb-6">
            <div class="flex items-center text-sm text-gray-500">
                <time class="capitalize" datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
                {{> "components/share-link" class="ml-auto" Tracking_name="Note"}}
            </div>
            <h1 class="text-3xl md:text-4xl text-title leading-tight mt-3">{{title}}</h1>
        </header>

        {{!-- Note content, one size up like a lead status --}}
        <div class="note-single-body post-body {{@custom.post_font}} text-xl md:text-2xl leading-relaxed">
            {{content}}
        </div>

        {{#if feature_image}}
        <figure class="note-single-media block mt-6 overflow-hidden rounded-lg border border-gray-300">
            <img class="block w-full simply-zoom"
                srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w"
                sizes="(max-width: 730px) 600px, 100vw"
                src="{{img_url feature_image size="l"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
        </figure>
        {{/if}}

        {{#has tag="count:>1"}}
        <footer class="note-single-footer flex items-center flex-wrap gap-x-3 gap-y-2 mt-8 pt-5 border-t border-gray-300 text-sm text-gray-500">
            {{#foreach tags}}
                {{#match visibility "=" "public"}}
                    <a href="/notes/{{slug}}/" class="hover:underline">#{{name}}</a>
                {{/match}}
            {{/foreach}}
        </footer>
        {{/has}}

        {{> "components/telegram-card"}}
    </div>
</article>
