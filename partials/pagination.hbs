{{!-- Infinite scroll with a "load more" button (src/js/pagination.js); plain links otherwise. --}}
{{#match @custom.pagination "Infinite Scroll"}}
{{#if next}}
<nav class="pagination" hidden><a class="older-posts" href="{{page_url next}}">Ещё</a></nav>

<button class="act load-more-btn hidden" type="button" aria-busy="false" data-label-default="Показать ещё" data-label-loading="Загрузка…">
    <span class="load-more-label">Показать ещё</span>
</button>

<div class="feed-loading-status" role="status" aria-live="polite" hidden>Загрузка…</div>

<div class="feed-load-error" role="alert" hidden>
    <span>Не загрузилось.</span>
    <a class="feed-load-retry" href="{{page_url next}}">Ещё раз</a>
</div>
{{/if}}
{{else}}
{{#if pages}}
<nav class="pagination pager" aria-label="Страницы">
    {{#if prev}}<a class="act" href="{{page_url prev}}">{{> "site/icon" name="left"}}Новее</a>{{else}}<span></span>{{/if}}
    {{#if next}}<a class="act older-posts" href="{{page_url next}}">Старее{{> "site/icon" name="right"}}</a>{{/if}}
</nav>
{{/if}}
{{/match}}
