{{!< default}}
{{!-- A static page: title, cover and content in the post column, nothing below. --}}
{{#contentFor "special_body_class"}}is-post is-page{{/contentFor}}

{{#post}}
<article class="post">
    {{#match @page.show_title_and_feature_image}}
    <h1 class="post-title">{{title}}</h1>
    {{#if feature_image}}
    <img class="cover"
        src="{{img_url feature_image size="l"}}"
        srcset="{{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w"
        sizes="(max-width: 712px) calc(100vw - 32px), 632px"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{/if}}"
        fetchpriority="high" decoding="async">
    {{/if}}
    {{/match}}

    <div class="content post-body" id="post-body">{{content}}</div>
</article>
{{/post}}
