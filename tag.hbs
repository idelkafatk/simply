{{!< default}}
{{!-- The tag above means - insert everything in this file into the {body} of the default.hbs template --}}

{{#tag}}

{{!-- custom Styles For tag <body> --}}
{{#contentFor "special_body_class"}}is-tag{{/contentFor}}

{{!-- Set in type like the Notes page (docs/mobile-design.md): the name, the
      post count the menu shows next to this tag, then the description. --}}
<section class="tag pt-8 lg:pt-12">
    <div class="mx-auto px-4 max-w-extreme">
        <h1 class="capitalize text-4xl text-title leading-tight lg:text-5xl">{{name}}</h1>

        <p class="mt-2 text-sm font-medium text-gray-500">{{plural ../pagination.total empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")}}</p>

        {{#if description}}<p class="mt-3 max-w-xl text-gray-500 lg:text-lg">{{description}}</p>{{/if}}
    </div>
</section>
{{/tag}}

{{!-- Matching notes carousel + tagged stories --}}
<div class="site-post mx-auto max-w-extreme py-vmin8 px-4">
    {{#get "posts" filter="tag:hash-note+tag:{{tag.slug}}" limit="10" as |notes|}}
        {{#if notes}}
            {{> "components/notes-carousel" carouselId="tag-notes" widgetTitle=(t "Notes") widgetPosts=notes}}
        {{/if}}
    {{/get}}

    <div class="tag-post-feed js-feed-entry grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{#foreach posts}}
            {{#has tag="#note, hash-note"}}
                {{!-- Matching notes are surfaced separately --}}
            {{else}}
                {{> "story/story-grid"}}
            {{/has}}
        {{/foreach}}
    </div>

    {{!-- Pagination - partials/pagination.hbs --}}
    {{pagination}}
</div>
