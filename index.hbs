{{!-- Layout --}}
{{!< default}}

{{!-- Publication Cover - partials/home/publication-cover.hbs --}}
{{!-- {{> "home/publication-cover"}} --}}

{{!-- Feed Stories + Notes sidebar --}}
<div class="site-post mx-auto max-w-extreme py-vmin8 px-4">
    <div class="grid gap-10 xl:gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="min-w-0">
            <div class="js-feed-entry grid md:grid-cols-2 gap-6">
                {{#foreach posts}}
                    {{#has tag="#note, hash-note"}}
                        {{!-- Notes are surfaced in the sidebar + /notes/, skipped in the main feed --}}
                    {{else}}
                        {{> "story/story-grid"}}
                    {{/has}}
                {{/foreach}}

                {{#get "posts" filter="tag:[hash-note]" limit="3" as |mobile_notes|}}
                    {{#if mobile_notes}}
                        <aside class="js-mobile-notes-widget sidebar-notes-widget hidden md:col-span-2">
                            {{> "sidebar/sidebar-notes" widgetTitle=(t "Latest Notes") widgetPosts=mobile_notes}}
                        </aside>
                    {{/if}}
                {{/get}}
            </div>

            {{!-- Pagination - partials/pagination.hbs --}}
            {{pagination}}
        </div>

        {{!-- Latest notes - partials/sidebar/notes-widget.hbs --}}
        {{> "sidebar/notes-widget" class="hidden lg:flex"}}
    </div>
</div>
