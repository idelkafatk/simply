{{!-- Layout --}}
{{!< default}}

{{!-- Publication Cover - partials/home/publication-cover.hbs --}}
{{!-- {{> "home/publication-cover"}} --}}

{{!-- Notes carousel + stories --}}
<div class="site-post mx-auto max-w-extreme py-vmin8 px-4">
    {{#get "posts" filter="tag:[hash-note]" limit="10" as |notes|}}
        {{#if notes}}
            {{> "components/notes-carousel" carouselId="home-notes" widgetTitle=(t "Latest Notes") widgetPosts=notes}}
        {{/if}}
    {{/get}}

    <div class="js-feed-entry grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{#foreach posts}}
            {{#has tag="#note, hash-note"}}
                {{!-- Notes are surfaced in the carousel + /notes/, skipped in the main feed --}}
            {{else}}
                {{> "story/story-grid"}}
            {{/has}}
        {{/foreach}}
    </div>

    {{!-- Pagination - partials/pagination.hbs --}}
    {{pagination}}
</div>
