{
  "id": "/",
  "name": "{{@site.title}}",
  "short_name": "{{@site.title}}",
  "description": "{{@site.description}}",
  "lang": "{{@site.locale}}",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  {{#match @custom.color_scheme "Dark"}}
  "background_color": "#151719",
  "theme_color": "#151719",
  {{else}}
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  {{/match}}
  "icons": [
    {{#if @site.icon}}
    {
      "src": "{{img_url @site.icon size="pwa_192"}}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{img_url @site.icon size="pwa_512"}}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
    {{else}}
    {
      "src": "{{asset "images/pwa/icon-192.png"}}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{asset "images/pwa/icon-512.png"}}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
    {{/if}}
  ],
  "categories": [
    "news",
    "personal"
  ]
}
