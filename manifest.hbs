{
  "id": "/",
  "name": "{{@site.title}}",
  "short_name": "{{@site.title}}",
  "description": "{{@site.description}}",
  "lang": "{{@site.locale}}",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  {{#match @custom.color_scheme "Dark"}}
  "background_color": "#151719",
  "theme_color": "#151719",
  {{else}}
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  {{/match}}
  "icons": [
    {{!--
      App icons never use @site.icon. The site icon is a round favicon with
      transparent corners, which reads well in browser tabs and search results
      but turns into a circle on a black square once installed. The bundled
      assets are full-bleed squares of the same artwork, in true 192/512 sizes
      (Chrome checks real dimensions for the install criteria).
    --}}
    {
      "src": "{{asset "images/pwa/icon-192.png"}}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{asset "images/pwa/icon-512.png"}}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "categories": [
    "news",
    "personal"
  ]
}
