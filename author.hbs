{{!< default}}
{{!-- The tag above means - insert everything in this file into the {body} of the default.hbs template --}}

{{#author}}

{{!-- custom Styles For tag <body> --}}
{{#contentFor "special_body_class"}}is-author has-cover is-head-transparent{{/contentFor}}

{{!-- Author content --}}
<div class="simply-hero-cover author shadow flex items-center justify-center relative min-h-lg py-24 bg-dark">

    {{!-- Featured Media - partials/components/media-cover.hbs --}}
    {{> "components/media-cover" background=cover_image has_gradient=true alt_title=name}}

    <article class="container relative flex flex-col text-center z-3 pt-16">
        {{!-- Author name --}}
        <h1 class="cover-title text-4xl lg:text-5xl my-5 text-white">{{name}}</h1>

        {{!-- Author avatar --}}
        <figure class="author-avatar relative mx-auto -order-1">
            <img class="w-52 h-52 rounded-full object-cover"
                src="{{#if profile_image}}{{img_url profile_image size="s"}}{{else}}{{asset "images/avatar.png"}}{{/if}}"
                alt="{{t "Hi I'm"}} {{name}}"
            />
        </figure>


        {{!-- author biography --}}
        {{#if bio}}<p class="cover-des mx-auto mb-8 text-xl text-white max-w-3xl">{{bio}}</p>{{/if}}

        {{!-- Author location and website --}}
        <div class="author-meta buttons justify-center">
            {{#if location}}
                <span class="author-location button is-static bg-transparent opacity-70 text-white">
                    <svg class="icon is-stroke"><use xlink:href="#icon-map"></use></svg>
                    <span>{{location}}</span>
                </span>
            {{/if}}

            {{#if website}}
                <a href="{{website}}" class="author-link button bg-transparent opacity-70 hover:opacity-100 hover:text-white hover:bg-transparent text-white" target="_blank" rel="noopener noreferrer">
                    <svg class="icon is-stroke"><use xlink:href="#icon-link"></use></svg>
                    <span>{{website}}</span>
                </a>
            {{/if}}

            {{#if linkedin}}
                <a href="{{social_url type="linkedin"}}" title="LinkedIn" aria-label="LinkedIn" class="author-linkedin button bg-transparent opacity-70 hover:opacity-100 hover:text-white hover:bg-transparent text-white" target="_blank" rel="noopener noreferrer">
                    <svg class="icon"><use xlink:href="#icon-linkedin"></use></svg>
                    <span>LinkedIn</span>
                </a>
            {{/if}}

            <a href="https://discord.gg/QACxna8mr7" title="Discord-сервер" aria-label="Discord-сервер" class="author-discord button bg-transparent opacity-70 hover:opacity-100 hover:text-white hover:bg-transparent text-white" target="_blank" rel="noopener noreferrer">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.445.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.618-1.25.077.077 0 0 0-.078-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.028C.533 9.046-.319 13.58.099 18.058a.082.082 0 0 0 .031.056c2.053 1.508 4.042 2.423 5.993 3.03a.078.078 0 0 0 .084-.028c.462-.63.873-1.295 1.226-1.994a.076.076 0 0 0-.042-.106 12.3 12.3 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .078-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .079.009c.12.099.246.198.373.292a.077.077 0 0 1-.007.128 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.363 1.225 1.993a.076.076 0 0 0 .084.029c1.961-.607 3.95-1.522 6.002-3.03a.077.077 0 0 0 .031-.055c.5-5.177-.838-9.674-3.548-13.66a.061.061 0 0 0-.031-.029ZM8.02 15.331c-1.182 0-2.157-1.086-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.211 0 2.176 1.095 2.157 2.419 0 1.333-.956 2.419-2.157 2.419Zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.211 0 2.176 1.095 2.157 2.419 0 1.333-.946 2.419-2.157 2.419Z"></path>
                </svg>
                <span>Discord-сервер</span>
            </a>
        </div>

        {{!-- Author Facebook and Twitter --}}
        {{#has any="facebook,twitter"}}
        <div class="author-follow buttons justify-center mt-8">
            {{#if facebook}}
            <a href="{{facebook_url}}" title="Facebook" class="button text-white bg-transparent hover:text-white hover:bg-transparent" target="_blank" rel="noopener noreferrer">
                <svg class="icon"><use xlink:href="#icon-facebook"></use></svg>
                </a>
            {{/if}}

            {{#if twitter}}
            <a href="{{twitter_url}}" title="{{twitter}}" class="button text-white bg-transparent hover:text-white hover:bg-transparent" target="_blank" rel="noopener noreferrer">
                <svg class="icon"><use xlink:href="#icon-twitter"></use></svg>
            </a>
            {{/if}}
        </div>
        {{/has}}
    </article>
</div>
{{/author}}

{{!-- Personal author description. Kept in the theme because this is a single-author blog. --}}
<section class="container mx-auto py-vw6">
    <div class="mx-auto max-w-3xl text-lg leading-relaxed">
        <h2 class="text-title text-3xl lg:text-4xl mb-8">Привет! Я Идель 👋</h2>

        <div class="space-y-5 text-gray-700">
            <p>Я фронтенд-разработчик, родом из Башкортостана. Здесь пишу в основном о релокации, путешествиях и жизни за границей — о вещах, с которыми столкнулся сам.</p>

            <p>Визы, документы, жильё, банки, транспорт и бытовые мелочи, о которых обычно узнаёшь уже на месте.</p>

            <p>Иногда пишу о технологиях и разработке — всё-таки это большая часть моей жизни.</p>

            <p>В общем, это личный блог о моём опыте и вещах, которые могут пригодиться другим.</p>

            <p>Новые публикации и заметки также выходят в моём <a href="https://t.me/idel_blog" class="text-primary hover:underline" target="_blank" rel="me noopener noreferrer">Telegram-канале</a>.</p>
        </div>
    </div>
</section>

{{!-- The tag below includes the post loop - partials/loop.hbs --}}
{{>"loop" hideNotes=true notesAuthor=author.slug}}
