<html lang="{{@site.locale}}"{{#match @custom.color_scheme "Dark"}} class="dark"{{/match}}>
<head>
    {{!-- Document Settings --}}
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    {{!--
      Page Meta

      Collections from routes.yaml have no title of their own, so {{meta_title}} drops to its
      fallback branch: the site title plus a page suffix that Ghost adds whenever the collection
      holds more than one post — even on the first page. That turns /notes/ into "Idel.Blog
      (Page 1)". Name the notes section explicitly and keep the page number from page two on.
    --}}
    <title>{{#match relativeUrl "~^" "/notes/"}}{{t "Notes"}}{{#is "paged"}} ({{t "Page"}} {{pagination.page}}){{/is}} - {{@site.title}}{{else}}{{#is "paged"}}{{meta_title}}{{else}}{{meta_title page=""}}{{/is}}{{/match}}</title>

    {{!-- Mobile Meta --}}
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff" data-theme-color>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="{{@site.title}}">
    <link rel="manifest" href="{{@site.url}}/manifest/">
    {{#if @site.icon}}
    <link rel="apple-touch-icon" sizes="192x192" href="{{img_url @site.icon size="pwa_192"}}">
    {{else}}
    <link rel="apple-touch-icon" sizes="192x192" href="{{asset "images/pwa/icon-192.png"}}">
    {{/if}}
    {{> "pwa/apple-startup-images"}}

    {{!--
      Chrome fires beforeinstallprompt once and never replays it, and on a repeat
      visit it can fire before the deferred scripts/pwa.js has even parsed. Catch it
      here, at the earliest possible point, and let pwa.js collect it from window.
    --}}
    <script>
    (function () {
        window.addEventListener('beforeinstallprompt', function (event) {
            event.preventDefault();
            window.__pwaInstallEvent = event;
        });
    })();
    </script>

    <script>
    (function () {
        var root = document.documentElement;
        var themeColor = document.querySelector('[data-theme-color]');
        var systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
        var configuredTheme = 'auto';

        {{#match @custom.color_scheme "Dark"}}configuredTheme = 'dark';{{/match}}
        {{#match @custom.color_scheme "Light"}}configuredTheme = 'light';{{/match}}

        function readStoredTheme() {
            try {
                var storedTheme = window.localStorage.getItem('theme');
                return storedTheme === 'dark' || storedTheme === 'light'
                    ? storedTheme
                    : null;
            } catch (error) {
                return null;
            }
        }

        function applyTheme(theme) {
            var isDark = theme === 'dark';
            root.classList.toggle('dark', isDark);
            root.dataset.theme = theme;
            root.style.colorScheme = theme;

            if (themeColor) {
                themeColor.setAttribute('content', isDark ? '#151719' : '#ffffff');
            }
        }

        function resolveTheme() {
            var storedTheme = readStoredTheme();
            if (storedTheme) return storedTheme;
            if (configuredTheme !== 'auto') return configuredTheme;
            return systemTheme.matches ? 'dark' : 'light';
        }

        window.simplyApplyTheme = function () {
            applyTheme(resolveTheme());
        };

        window.simplySetTheme = function (theme) {
            if (theme !== 'dark' && theme !== 'light') return;

            try {
                window.localStorage.setItem('theme', theme);
            } catch (error) {
                // Storage can be unavailable in private browsing modes.
            }

            applyTheme(theme);
        };

        function handleSystemThemeChange() {
            if (configuredTheme === 'auto' && !readStoredTheme()) {
                applyTheme(systemTheme.matches ? 'dark' : 'light');
            }
        }

        window.simplyApplyTheme();

        if (typeof systemTheme.addEventListener === 'function') {
            systemTheme.addEventListener('change', handleSystemThemeChange);
        } else if (typeof systemTheme.addListener === 'function') {
            systemTheme.addListener(handleSystemThemeChange);
        }
    }());
    </script>

    {{!-- Fonts -> Rubik=400,500,600,700 PT Serift=400,700 --}}
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&family=PT+Serif:ital,wght@0,400;0,700;1,400&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
    <noscript><link rel="preconnect" href="https://fonts.gstatic.com"><link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&family=PT+Serif:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"></noscript>
    {{!-- <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Serif:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"> --}}

    {{!-- Preload Hero Image --}}
    {{#if feature_image}}
    <link rel="preload" as="image" href="{{img_url feature_image size="l"}}">
    {{/if}}

    {{!-- Styles --}}
    <link rel="stylesheet" type="text/css" href="{{asset "styles/main.css"}}"/>
    {{!-- <style>{{> "main-styles"}}</style> --}}

    {{!-- Ghost outputs important style and meta data with this tag.
          "search" is excluded because the theme ships its own search UI
          (partials/search.hbs) instead of loading sodo-search. --}}
    {{ghost_head exclude="search"}}

    {{!-- Block for Headers --}}
    {{{block "header"}}}
</head>
<body class="{{block "special_body_class"}}">
    <div class="simply-viewport flex flex-col justify-start">
        {{!-- Header Content with User Account ./partials/layout/header-user-account.hbs --}}
        {{#match @custom.header "Default"}}{{> "layout/header"}}{{/match}}

        {{!-- Header With Drop Down --}}
        {{#match @custom.header "Drop Down Menu"}}{{> "layout/header" hasDropDown=true}}{{/match}}

        {{!-- All the main content gets inserted here, index.hbs, post.hbs, etc --}}
        <main class="simply-main relative min-h-lg">{{{body}}}</main>

        {{!-- Footer Default ./partials/layout/footer.hbs --}}
        {{#match @custom.footer "Default"}}{{>"layout/footer"}}{{/match}}

        {{!-- Footer - Dark ./partials/layout/footer-dark.hbs --}}
        {{#match @custom.footer "Dark"}}{{>"layout/footer-dark"}}{{/match}}

        {{!-- Footer Not Menu ./partials/layout/footer-not-menu.hbs --}}
        {{#match @custom.footer "No Secondary Navigation"}}{{>"layout/footer-not-menu"}}{{/match}}
    </div>

    {{!-- Mobile Navigation stays outside the pull-to-refresh transform container. --}}
    {{> "mobile-navigation"}}

    {{!-- Loading Bar --}}
    <div class="loadingBar top-0 fixed right-0 left-0 hidden" role="progressbar" aria-label="{{t "Loading..."}}" aria-hidden="true"></div>

    <div
        class="pull-to-refresh"
        data-pull-to-refresh
        data-message-pull="{{t "Pull to refresh"}}"
        data-message-release="{{t "Release to refresh"}}"
        data-message-refreshing="{{t "Refreshing..."}}"
        role="status"
        aria-live="polite"
        aria-hidden="true"
    >
        {{> "icons/loader"}}
        <span class="sr-only" data-pull-to-refresh-status>{{t "Pull to refresh"}}</span>
    </div>

    {{!-- Search --}}
    {{> "search"}}

    {{!-- PWA install invitation, revealed after a few articles --}}
    {{> "pwa/install-prompt"}}

    {{!-- Icons --}}
    {{> "icons/icons-symbol-defs"}}

    {{!-- Scripts URL --}}
    <script>
        var prismJs = '{{asset "scripts/prismjs.js"}}';
        var prismJsComponents = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.28.0/components/';
    </script>

    {{!-- Ghost outputs important scripts and data with this tag --}}
    {{ghost_foot}}

    {{!-- script --}}
    {{{block "scripts"}}}

    {{!-- Main scripts --}}
    <script src="{{#is "post, page"}}{{asset "scripts/post.js"}}{{else}}{{asset "scripts/main.js"}}{{/is}}" defer></script>
    <script src="{{asset "scripts/pwa.js"}}" defer></script>

    {{!-- Pagination Infinite Scroll --}}
    {{#match @custom.pagination "Infinite Scroll"}}{{#if pagination.next}}<script src="{{asset "scripts/pagination.js"}}" defer async></script>{{/if}}{{/match}}
</body>
</html>
