<!DOCTYPE html>
<html lang="{{@site.locale}}"{{#match @custom.color_scheme "Dark"}} class="dark"{{/match}}>
<head>
    <meta charset="utf-8" />

    {{!--
      Collections and channels from routes.yaml have no title of their own, so
      {{meta_title}} falls back to the site title plus "(Page 1)". The topic
      channels get their own name; the page number only shows from page two on.
    --}}
    <title>{{#match relativeUrl "~^" "/life/"}}Жизнь{{#is "paged"}} ({{t "Page"}} {{pagination.page}}){{/is}} — {{@site.title}}{{else match relativeUrl "~^" "/trips/"}}Поездки{{#is "paged"}} ({{t "Page"}} {{pagination.page}}){{/is}} — {{@site.title}}{{else match relativeUrl "~^" "/tech/"}}Технологии{{#is "paged"}} ({{t "Page"}} {{pagination.page}}){{/is}} — {{@site.title}}{{else match relativeUrl "~^" "/notes/"}}{{t "Notes"}}{{#is "paged"}} ({{t "Page"}} {{pagination.page}}){{/is}} — {{@site.title}}{{else}}{{#is "paged"}}{{meta_title}}{{else}}{{meta_title page=""}}{{/is}}{{/match}}</title>

    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff" data-theme-color>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="{{@site.title}}">
    <link rel="manifest" href="{{@site.url}}/manifest/">
    {{!-- Square bundled icon, not @site.icon: the round favicon would get black corners on the iOS home screen. --}}
    <link rel="apple-touch-icon" sizes="192x192" href="{{asset "images/pwa/icon-192.png"}}">
    {{> "pwa/apple-startup-images"}}

    {{!--
      Chrome fires beforeinstallprompt once and never replays it, and on a repeat
      visit it can fire before the deferred scripts/pwa.js has even parsed. Catch it
      here, at the earliest possible point, and let pwa.js collect it from window.
    --}}
    <script>
    (function () {
        window.addEventListener('beforeinstallprompt', function (event) {
            event.preventDefault();
            window.__pwaInstallEvent = event;
        });
    })();
    </script>

    <script>
    (function () {
        var root = document.documentElement;
        // CSS can tell from this that the theme's scripts will run, e.g. that
        // video cards next to a gallery will move into its carousel.
        root.classList.add('has-js');
        var themeColor = document.querySelector('[data-theme-color]');
        var systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
        var configuredTheme = 'auto';

        {{#match @custom.color_scheme "Dark"}}configuredTheme = 'dark';{{/match}}
        {{#match @custom.color_scheme "Light"}}configuredTheme = 'light';{{/match}}

        function readStoredTheme() {
            try {
                var storedTheme = window.localStorage.getItem('theme');
                return storedTheme === 'dark' || storedTheme === 'light'
                    ? storedTheme
                    : null;
            } catch (error) {
                return null;
            }
        }

        function applyTheme(theme) {
            var isDark = theme === 'dark';
            root.classList.toggle('dark', isDark);
            root.dataset.theme = theme;
            root.style.colorScheme = theme;

            if (themeColor) {
                themeColor.setAttribute('content', isDark ? '#161719' : '#ffffff');
            }
        }

        function resolveTheme() {
            var storedTheme = readStoredTheme();
            if (storedTheme) return storedTheme;
            if (configuredTheme !== 'auto') return configuredTheme;
            return systemTheme.matches ? 'dark' : 'light';
        }

        window.simplyApplyTheme = function () {
            applyTheme(resolveTheme());
        };

        window.simplySetTheme = function (theme) {
            if (theme !== 'dark' && theme !== 'light') return;

            try {
                window.localStorage.setItem('theme', theme);
            } catch (error) {
                // Storage can be unavailable in private browsing modes.
            }

            applyTheme(theme);
        };

        function handleSystemThemeChange() {
            if (configuredTheme === 'auto' && !readStoredTheme()) {
                applyTheme(systemTheme.matches ? 'dark' : 'light');
            }
        }

        window.simplyApplyTheme();

        if (typeof systemTheme.addEventListener === 'function') {
            systemTheme.addEventListener('change', handleSystemThemeChange);
        } else if (typeof systemTheme.addListener === 'function') {
            systemTheme.addListener(handleSystemThemeChange);
        }
    }());
    </script>

    {{!-- Rubik for everything, the post body included --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">

    {{!-- The cover is the largest thing on the first screen of a post --}}
    {{#is "post"}}{{#if feature_image}}
    <link rel="preload" as="image" href="{{img_url feature_image size="l"}}" imagesrcset="{{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w" imagesizes="(max-width: 712px) calc(100vw - 32px), 632px" fetchpriority="high">
    {{/if}}{{/is}}

    <link rel="stylesheet" type="text/css" href="{{asset "styles/main.css"}}"/>

    {{!-- Ghost outputs important style and meta data with this tag.
          "search" is excluded because the theme ships its own search UI
          (partials/search.hbs) instead of loading sodo-search. --}}
    {{ghost_head exclude="search"}}

    {{{block "header"}}}
</head>
<body class="{{body_class}} {{block "special_body_class"}}">
    <div class="col">
        {{> "site/bar"}}

        <main class="page" id="main">{{{body}}}</main>

        {{> "site/footer"}}
    </div>

    {{!-- Loading bar for page-to-page navigation (src/js/navigation.js) --}}
    <div class="loadingBar" role="progressbar" aria-label="{{t "Loading..."}}" aria-hidden="true"></div>

    {{!-- Pull to refresh in the installed app (src/js/navigation.js) --}}
    <div
        class="pull-to-refresh"
        data-pull-to-refresh
        data-message-pull="{{t "Pull to refresh"}}"
        data-message-release="{{t "Release to refresh"}}"
        data-message-refreshing="{{t "Refreshing..."}}"
        role="status"
        aria-live="polite"
        aria-hidden="true"
    >
        {{> "icons/loader"}}
        <span class="sr-only" data-pull-to-refresh-status>{{t "Pull to refresh"}}</span>
    </div>

    {{> "site/subscribe-modal"}}

    {{> "search"}}

    {{!-- PWA install invitation, revealed after a few articles --}}
    {{> "pwa/install-prompt"}}

    {{!-- Scripts URL --}}
    <script>
        var prismJs = '{{asset "scripts/prismjs.js"}}';
        var prismJsComponents = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.28.0/components/';
    </script>

    {{ghost_foot}}

    {{{block "scripts"}}}

    <script src="{{#is "post, page"}}{{asset "scripts/post.js"}}{{else}}{{asset "scripts/main.js"}}{{/is}}" defer></script>
    <script src="{{asset "scripts/pwa.js"}}" defer></script>

    {{#match @custom.pagination "Infinite Scroll"}}{{#if pagination.next}}<script src="{{asset "scripts/pagination.js"}}" defer async></script>{{/if}}{{/match}}
</body>
</html>
